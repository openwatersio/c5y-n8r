{
  "name": "@openwaters/c5y-n8r",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data": "./data/countries.crdb"
  },
  "scripts": {
    "generate": "flatc --ts --ts-flat-files --gen-object-api -o src/generated schema/countries.fbs",
    "source:fetch": "node --import tsx scripts/fetch-wikidata.ts",
    "build": "npm run build:reader && node --import tsx scripts/build.ts",
    "test": "npm run build:reader && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --import tsx scripts/demo.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "evidence": "node --import tsx scripts/check-evidence.ts",
    "check": "npm run typecheck && npm test",
    "build:reader": "tsc -p tsconfig.build.json",
    "prepare": "npm run build:reader"
  },
  "dependencies": {
    "flatbuffers": "25.9.23"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "countries-list": "3.4.1",
    "country-code-lookup": "0.2.1",
    "country-codes-list": "3.2.0",
    "i18n-iso-countries": "7.14.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "data",
    "schema/countries.fbs",
    "sources/manifest.json",
    "DATA_LICENSE.md",
    "LICENSE",
    "README.md",
    "sources/licenses/country-code-lookup-MIT.txt",
    "sources/reviewed-overrides.json",
    "sources/review-approvals.json",
    "sources/override-activation.json"
  ]
}
